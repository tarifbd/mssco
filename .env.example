# ==============================================================================
# SITE CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_SITE_URL="https://example-ca-bd.com"

# ==============================================================================
# CONTACT FORM DELIVERY (OPTION 1: RESEND API - RECOMMENDED)
# ==============================================================================
# Obtain an API key from https://resend.com
RESEND_API_KEY=""
# Verified sender address in Resend (e.g., "Enquiries <noreply@yourdomain.com>")
CONTACT_FROM_EMAIL="onboarding@resend.dev"
# Destination email address where client enquiries are delivered
CONTACT_TO_EMAIL="contact@example-ca-bd.com"

# ==============================================================================
# CONTACT FORM DELIVERY (OPTION 2: NODEMAILER SMTP FALLBACK)
# ==============================================================================
# Used automatically if RESEND_API_KEY is not set and SMTP_HOST is configured
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ==============================================================================
# OPTIONAL: ANTI-SPAM CAPTCHA (CLOUDFLARE TURNSTILE)
# ==============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
